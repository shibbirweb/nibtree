{
  "name": "nibtree",
  "version": "0.1.0-beta.13",
  "description": "Native Git GUI with a 3-way merge tool",
  "author": {
    "name": "MD. Shibbir Ahmed",
    "url": "https://github.com/shibbirweb"
  },
  "homepage": "https://github.com/shibbirweb/nibtree",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shibbirweb/nibtree.git"
  },
  "bugs": {
    "url": "https://github.com/shibbirweb/nibtree/issues"
  },
  "type": "module",
  "workspaces": [
    "ui/web"
  ],
  "scripts": {
    "dev": "bun --bun vite dev",
    "build": "bun --bun vite build",
    "preview": "bun --bun vite preview",
    "prepare": "bun --bun svelte-kit sync || echo ''",
    "check": "bun --bun svelte-kit sync && bun --bun svelte-check --tsconfig ./tsconfig.json && bun --bun svelte-check --tsconfig ./ui/web/tsconfig.json",
    "test": "bun --bun vitest run",
    "test:watch": "bun --bun vitest",
    "tauri": "bunx --bun tauri",
    "ui": "bun --bun vite --config ui/web/vite.config.ts",
    "ui:docs": "bun ui/web/scripts/docs.ts",
    "ui:tokens": "bun ui/design-tokens/scripts/tokens.ts",
    "ui:parity": "bun --bun ui/web/scripts/parity.ts",
    "ui:mcp": "bun ui/mcp/server.ts",
    "ui:themes": "bun --bun ui/web/scripts/themes.ts",
    "ui:migration": "bun ui/web/scripts/migration.ts",
    "format": "bun --bun prettier --write \"src/**/*.{ts,svelte,css}\" \"ui/**/*.{ts,svelte,css,json}\" \"scripts/**/*.ts\" \"npm/**/*.{mjs,json}\"",
    "format:check": "bun --bun prettier --check \"src/**/*.{ts,svelte,css}\" \"ui/**/*.{ts,svelte,css,json}\" \"scripts/**/*.ts\" \"npm/**/*.{mjs,json}\""
  },
  "license": "MIT",
  "dependencies": {
    "@nibtree/ui": "workspace:*",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-go": "^6.0.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-php": "^6.0.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/legacy-modes": "^6.5.4",
    "@codemirror/merge": "^6.12.2",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@lezer/highlight": "^1.2.5",
    "@sanity/diff-match-patch": "3.2.1",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.8.0",
    "@tauri-apps/plugin-opener": "^2.7.0",
    "@tiptap/core": "3.31.3",
    "@tiptap/extension-code": "3.31.3",
    "@tiptap/extension-code-block": "3.31.3",
    "@tiptap/extension-image": "3.31.3",
    "@tiptap/extension-link": "3.31.3",
    "@tiptap/extension-list": "3.31.3",
    "@tiptap/extension-paragraph": "3.31.3",
    "@tiptap/extension-table": "3.31.3",
    "@tiptap/extension-task-item": "3.31.3",
    "@tiptap/extension-task-list": "3.31.3",
    "@tiptap/extensions": "3.31.3",
    "@tiptap/markdown": "3.31.3",
    "@tiptap/pm": "3.31.3",
    "@tiptap/starter-kit": "3.31.3",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "diff": "8.0.4",
    "dompurify": "^3.4.16",
    "markdown-it": "^15.0.2",
    "marked": "17.0.1",
    "mermaid": "^12.0.0"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.65.1",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tauri-apps/cli": "^2",
    "happy-dom": "20.14.5",
    "material-icon-theme": "5.39.0",
    "playwright": "^1.63.0",
    "prettier": "3.9.10",
    "prettier-plugin-svelte": "4.1.1",
    "svelte": "^5.56.3",
    "svelte-check": "^4.6.0",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vitest": "^5.0.2"
  }
}
