{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nibtree",
  "identifier": "io.github.shibbirweb.nibtree",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Nibtree",
        "width": 1400,
        "height": 880,
        "minWidth": 960,
        "minHeight": 600,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 14, "y": 23.5 }
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: gmpreview: http://gmpreview.localhost; frame-src 'self' gmpreview: http://gmpreview.localhost; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost https://api.github.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "DeveloperTool",
    "publisher": "MD. Shibbir Ahmed",
    "copyright": "Copyright 2026 MD. Shibbir Ahmed",
    "shortDescription": "Git GUI with a 3-way merge tool",
    "longDescription": "Git client with a three pane merge tool, workspaces, tabs, blame, history and a terminal.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
