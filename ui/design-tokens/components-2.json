{
  "$comment": [
    "More component measurements, read together with components.json (one file would pass 300 lines).",
    "The same rules apply: \"{group.name}\" refers to a token, numbers are points."
  ],
  "bulletList": {"indent": 18},
  "fontSample": {"paddingY": 10, "paddingX": 12},
  "table": {"rowHeight": 28, "paddingX": 10, "gap": 8},
  "popupRow": {"paddingY": 4, "paddingX": 8, "gap": 8, "iconColumn": 16, "chevronColumn": 14, "hintMaxWidth": 200},
  "optionList": {
    "height": 236, "padding": 4, "optionPaddingY": 3, "optionPaddingX": 6, "optionGap": 8, "groupPaddingTop": 6,
    "groupPaddingX": 6, "groupPaddingBottom": 3
  },
  "dragGhost": {"maxWidth": 260, "paddingY": 3, "paddingX": 8, "offsetX": 14, "offsetY": 10},
  "renameField": {"height": 20, "paddingX": 4, "radius": 3},
  "cornerCard": {"inset": 12, "paddingY": 6, "paddingRight": 6, "paddingLeft": 12, "gap": 8},
  "splitGrid": {"splitterLayer": 20},
  "paneRow": {"focusLine": 1},
  "crumbPopup": {
    "fieldHeight": 28, "fieldPaddingX": 8, "gap": 6, "listPadding": 3, "rowHeight": 24, "rowPaddingX": 6,
    "iconWidth": 16, "width": 340, "maxHeight": 440, "minHeight": 120, "offset": 3, "inset": 8, "roomBelow": 200,
    "layer": 890
  },
  "notification": {
    "width": 380, "radius": "{radius.dialog}", "paddingY": 12, "paddingLeft": 12, "paddingRight": 8, "gap": 10,
    "lineGap": 4, "rowPaddingY": 10, "rowPaddingLeft": 12, "rowPaddingRight": 6, "detailMaxHeight": 160, "dot": 7
  },
  "splitHandle": {"width": 7, "line": 3, "layer": 5},
  "windowLayer": {"layer": 500},
  "row": {
    "indent": 14, "chevron": 14, "actionsGap": 2, "treeHeight": "{size.treeRow}", "treePaddingX": 6, "treeGap": 5,
    "listHeight": "{size.treeRow}", "listPaddingX": 10, "listGap": 8, "historyHeight": 26, "historyPaddingX": 10,
    "historyGap": 10, "entryPaddingY": 4, "entryPaddingX": 10, "entryGap": 10, "largeMinHeight": 56,
    "largePaddingY": 10, "largePaddingX": 12, "largeGap": 14, "largeRadius": 8, "sectionHeight": 28,
    "sectionPaddingX": 5, "sectionGap": 4, "groupHeight": "{size.treeRow}", "groupPaddingLeft": 24,
    "groupPaddingRight": 6, "groupGap": 6, "markWidth": 3, "markInset": 5
  },
  "scrollbar": {"size": 10, "thumbRadius": 10, "thumbInset": 2},
  "menuBar": {
    "height": 30, "paddingX": 4, "gap": 0, "itemPaddingX": 8, "itemHeight": 24, "itemRadius": "{radius.small}"
  }
}
